/*******************************************************************************
    Project: autoplay
    Author: Reha Tuncer
    Date: 02.07.2025
    Description: figure histogram time choice vs seconds typed - DUAL DISTRIBUTION
*******************************************************************************/
//# preamble
version 18
clear all
macro drop _all
set more off
set scheme s2color, permanently
set maxvar 32767
global graph_opts ///
    graphregion(fcolor(white) lcolor(white)) ///
    bgcolor(white) ///
    plotregion(lcolor(white))
	
global dpath "/Users/reha.tuncer/Documents/GitHub/autoplay/stata/"
global fpath "/Users/reha.tuncer/Documents/GitHub/autoplay/stata/figures/"
set scheme s2color, permanently	
	
use "${dpath}cleaned_autoplay_data.dta", replace
keep if !flag

gen prop_typing_choice = typeChoice/1200 // day 1 plan
sum prop_typing_choice
local mean1 = r(mean)
local sd1 = r(sd)
gen z_ptc = (prop_typing_choice-`mean1')/(`sd1')

gen type_act_prop = seconds_typing/session_duration // actualized day 2
sum type_act_prop
local mean1 = r(mean)
local sd1 = r(sd)
gen z_tap = (type_act_prop-`mean1')/(`sd1')

preserve
// Generate descriptive statistics for both distributions
foreach var in prop_typing_choice type_act_prop {
    quietly sum `var', detail
    scalar mean_`var' = r(mean)
    scalar median_`var' = r(p50)
    scalar sd_`var' = r(sd)
    scalar min_`var' = r(min)
    scalar max_`var' = r(max)
    scalar p25_`var' = r(p25)
    scalar p75_`var' = r(p75)
    scalar iqr_`var' = r(p75) - r(p25)
    scalar n_`var' = r(N)
}

// Generate boxplot statistics for both variables
foreach var in prop_typing_choice type_act_prop {
    egen med_`var' = median(`var')
    egen lqt_`var' = pctile(`var'), p(25)
    egen uqt_`var' = pctile(`var'), p(75)
    egen iqr_stat_`var' = iqr(`var')
    egen mean_stat_`var' = mean(`var')
    gen l_`var' = `var' if(`var' >= lqt_`var' - 1.5*iqr_stat_`var')
    egen ls_`var' = min(l_`var')
    gen u_`var' = `var' if(`var' <= uqt_`var' + 1.5*iqr_stat_`var')
    egen us_`var' = max(u_`var')
}

// Set positions for boxplots
gen ypos_tc = -2    // Position for prop_typing_choice boxplot
gen ypos_st = -4    // Position for type_act_prop boxplot

// Calculate common range for both variables
sum prop_typing_choice
local min1 = r(min)
local max1 = r(max)
local n1 = r(N)
sum type_act_prop
local min2 = r(min)
local max2 = r(max)
local n2 = r(N)
local min = min(`min1',`min2')
local max = max(`max1',`max2')
local n = min(`n1',`n2')
local bins = 15
local width = (`max'-`min')/`bins'

// Create the dual histogram with boxplots
twoway (histogram type_act_prop, percent start(`min') width(`width') ///
        fcolor(orange%60) lcolor(gs4) lwidth(thin)) ///
       (histogram prop_typing_choice, percent start(`min') width(`width') ///
        fcolor(dknavy%60) lcolor(gs4) lwidth(thin)) ///
       || rbar lqt_prop_typing_choice uqt_prop_typing_choice ypos_tc, horiz fcolor(dknavy*.7) lcolor(gs4) barw(1.2) ///
       || rbar med_prop_typing_choice uqt_prop_typing_choice ypos_tc, horiz fcolor(dknavy*.7) lcolor(gs4) barw(1.2) ///
       || rspike lqt_prop_typing_choice ls_prop_typing_choice ypos_tc, horiz lcolor(gs4) ///
       || rspike uqt_prop_typing_choice us_prop_typing_choice ypos_tc, horiz lcolor(gs4) ///
       || rcap ls_prop_typing_choice ls_prop_typing_choice ypos_tc, horiz msize(*1) lcolor(gs4) ///
       || rcap us_prop_typing_choice us_prop_typing_choice ypos_tc, horiz msize(*1) lcolor(gs4) ///
       || scatter ypos_tc mean_stat_prop_typing_choice, msymbol(o) msize(*.5) fcolor(gs4) mcolor(gs4) ///
       || rbar lqt_type_act_prop uqt_type_act_prop ypos_st, horiz fcolor(orange*.7) lcolor(gs4) barw(1.2) ///
       || rbar med_type_act_prop uqt_type_act_prop ypos_st, horiz fcolor(orange*.7) lcolor(gs4) barw(1.2) ///
       || rspike lqt_type_act_prop ls_type_act_prop ypos_st, horiz lcolor(gs4) ///
       || rspike uqt_type_act_prop us_type_act_prop ypos_st, horiz lcolor(gs4) ///
       || rcap ls_type_act_prop ls_type_act_prop ypos_st, horiz msize(*1) lcolor(gs4) ///
       || rcap us_type_act_prop us_type_act_prop ypos_st, horiz msize(*1) lcolor(gs4) ///
       || scatter ypos_st mean_stat_type_act_prop, msymbol(o) msize(*.5) fcolor(gs4) mcolor(gs4) ///
       , xlabel(0(.125)1, format(%9.0g)) ///
         ylabel(0(5)30, gmax angle(0)) ///
         ytitle("Percent") ///
         xtitle("Proportion of 20 min. for transcribing") ///
         legend(order(1 "Actual" 2 "Planned") ring(0) pos(10) rows(2) region(lcolor(none))) ///
         title("Distribution of Planned vs Actual Transcribing Time") ///
         graphregion(color(white)) bgcolor(white) ///
         name(dual_hist, replace)

graph export "${fpath}dual_typechoice_hist.png", replace

// Display comparative descriptive statistics
cls
preserve
gen plan_below75 = 1
replace plan_below75 = 0 if prop_typing_choice > .75

gen act_below75 = 1
replace act_below75 = 0 if type_act_prop > .75
tab plan_below75 act_below75
sum type_act_prop prop_typing_choice
restore

* Stata import code:
import delimited "stata_dataset.csv", clear

* Set panel structure
xtset participant_id second

* Label variables
label variable participant_id "Participant ID"
label variable second "Second (0-1199)"
label variable work "Work indicator (1=typing, 0=watching)"
label variable cumulative_work "Cumulative work time"
label variable mouseout "Mouseout >20s indicator"
label variable treatment "Treatment assignment"
label variable timechoice "Initial typing time preference"
label variable typecount "Number of captchas"
label variable watchedvideo "Number of video watched"
label variable behavior_type "Behavioral classification"
label variable work_ratio "Overall work ratio"

* Create treatment dummy
gen autoplay = .
replace autoplay = 0 if treatment == "autoplayOff"
replace autoplay = 1 if treatment == "autoplayOn"
label variable autoplay "Autoplay treatment (1=on, 0=off)"

encode behavior_type, generate(type)

* Summary statistics
summarize
xtdescribe
xtsum work


// Create transition variables
sort participant_id second
by participant_id: generate previous_work = work[_n-1]
generate transition = .
replace transition = 1 if previous_work == 0 & work == 1  // Leisure → Work
replace transition = 2 if previous_work == 1 & work == 1  // Work → Work  
replace transition = 3 if previous_work == 1 & work == 0  // Work → Leisure
replace transition = 4 if previous_work == 0 & work == 0  // Leisure → Leisure

// Multinomial logit for transition probabilities
mlogit transition autoplay c.second timechoice, base(2) cluster(participant_id)
sort behavior_type
by behavior_type: mlogit transition autoplay c.second timechoice, base(2)

// Focus on switching probabilities
generate switch = (work != previous_work) if !missing(previous_work)
logit switch autoplay c.second timechoice, cluster(participant_id)




// =============================================================================
// SURVIVAL ANALYSIS SETUP FOR WORK/LEISURE SPELLS
// Converting second-by-second data to spell-based survival data
// =============================================================================

// Start with your original long-format data
// Assume data is already loaded and sorted by participant_id second

// =============================================================================
// STEP 1: CREATE SPELL STRUCTURE
// =============================================================================

// Sort data properly
sort participant_id second

// Create spell indicators (when activity changes)
by participant_id: generate spell_start = (work != work[_n-1]) if _n > 1
by participant_id: replace spell_start = 1 if _n == 1  // First observation starts a spell

// Create spell ID for each participant
by participant_id: generate spell_id = sum(spell_start)

// =============================================================================
// STEP 2: CREATE SPELL-LEVEL DATASET
// =============================================================================

// For each spell, keep track of:
// - Spell type (work=1 or leisure=0)
// - Spell duration 
// - Whether spell was "completed" (ended naturally) or "censored" (session ended)
// - Start time of spell
// - Treatment and other covariates
sort participant_id spell_id
by participant_id spell_id: generate spell_length = _N
by participant_id spell_id: generate spell_type = work[1]  // 1=work spell, 0=leisure spell
by participant_id spell_id: generate spell_start_second = second[1]
by participant_id spell_id: generate spell_end_second = second[_N]

// Create failure indicator
// failure = 1 if spell ended due to switching (not censoring)
// failure = 0 if spell was censored (session ended while in that state)

bysort participant_id spell_id: generate last_spell = (_n == _N) & (spell_id == spell_id[_N])
bysort participant_id: generate session_last_spell = (spell_id == spell_id[_N])

generate failure = 1
replace failure = 0 if session_last_spell == 1  // Last spell of session is censored

// Keep one observation per spell
bysort participant_id spell_id: keep if _n == 1

// Add treatment and participant characteristics
// (assuming these are constant within participant)
bysort participant_id: replace autoplay = autoplay[1]
bysort participant_id: replace timechoice = timechoice[1] 
bysort participant_id: replace behavior_type = behavior_type[1]

// =============================================================================
// STEP 3: SURVIVAL ANALYSIS SETUP OPTIONS
// =============================================================================

// OPTION A: Analyze ALL spells together
stset spell_length, failure(failure) id(participant_id)

// Check the setup
stdes
stdescribe

// Basic survival analysis
stsum
stsum, by(autoplay)

// =============================================================================
// OPTION B: Analyze WORK spells only
// =============================================================================

preserve
keep if spell_type == 1  // Keep only work spells

// Declare survival data for work spells
stset spell_length, failure(failure) id(participant_id)

// Cox proportional hazards model for work spell duration
stcox autoplay timechoice spell_start_second, cluster(participant_id)

// Kaplan-Meier survival curves
sts graph, by(autoplay) title("Survival of Work Spells by Treatment")

// Parametric survival models
streg autoplay timechoice spell_start_second, distribution(exponential)
streg autoplay timechoice spell_start_second, distribution(weibull)

restore

// =============================================================================
// OPTION C: Analyze LEISURE spells only  
// =============================================================================

preserve
keep if spell_type == 0  // Keep only leisure spells

stset spell_length, failure(failure) id(participant_id)

// Analysis of leisure spell durations
stcox autoplay timechoice spell_start_second, cluster(participant_id)
sts graph, by(autoplay) title("Survival of Leisure Spells by Treatment")

restore

// =============================================================================
// OPTION D: Competing risks setup (work vs leisure endings)
// =============================================================================

// Create competing risk failure types
generate failure_type = 0  // No failure (censored)
replace failure_type = 1 if failure == 1 & spell_type == 1  // Work spell ended
replace failure_type = 2 if failure == 1 & spell_type == 0  // Leisure spell ended

// Competing risks survival setup
stset spell_length, failure(failure_type==1) id(participant_id)  // Work endings
// or
stset spell_length, failure(failure_type==2) id(participant_id)  // Leisure endings

// =============================================================================
// STEP 4: ALTERNATIVE APPROACHES IF STANDARD SURVIVAL DOESN'T WORK
// =============================================================================

// APPROACH 4A: Count data models (if durations are short)
// Poisson or negative binomial regression on spell lengths

poisson spell_length autoplay timechoice spell_start_second if spell_type==1, ///
        cluster(participant_id)
        
nbreg spell_length autoplay timechoice spell_start_second if spell_type==1, ///
      cluster(participant_id)

// APPROACH 4B: Log-normal regression on spell durations
generate ln_spell_length = ln(spell_length)
regress ln_spell_length autoplay timechoice spell_start_second if spell_type==1, ///
        cluster(participant_id)

// APPROACH 4C: Quantile regression (robust to outliers)
qreg spell_length autoplay timechoice spell_start_second if spell_type==1

// =============================================================================
// STEP 5: DIAGNOSTIC CHECKS
// =============================================================================

// Check spell length distribution
histogram spell_length, by(spell_type autoplay)
summarize spell_length, detail by(spell_type autoplay)

// Check for very short spells (might indicate noise)
tabulate spell_length if spell_length <= 5

// Check censoring patterns
tabulate failure spell_type
tabulate failure autoplay

// Check number of spells per participant
by participant_id: generate n_spells = _N
summarize n_spells
histogram n_spells, by(autoplay)

// =============================================================================
// STEP 6: RECOMMENDED ANALYSIS WORKFLOW
// =============================================================================

/*
1. Start with basic descriptive statistics:
   - Mean spell lengths by type and treatment
   - Censoring rates
   - Number of spells per participant

2. Try parametric survival models first:
   - Exponential (constant hazard)
   - Weibull (monotonic hazard)
   - Lognormal (non-monotonic hazard)

3. If those work, move to Cox models:
   - More flexible
   - Don't assume specific distribution

4. If survival analysis fails:
   - Use count models (Poisson/negative binomial)
   - Use log-normal regression
   - Use robust methods (quantile regression)
*/

// Basic descriptive analysis to start
tabstat spell_length, by(spell_type) statistics(mean median sd min max n)
tabstat spell_length, by(autoplay) statistics(mean median sd min max n)
table spell_type autoplay, contents(mean spell_length)


// Remove very short spells (likely noise)
drop if spell_length <= 3

// Create unique spell IDs to treat each spell independently  
generate unique_id = _n

// Simple survival setup
stset spell_length, failure(failure) id(unique_id)
stdescribe
// Cox model with participant clustering
stcox autoplay timechoice, cluster(participant_id)

sts graph, by(autoplay) title("Spell Survival by Treatment")
sts graph, by(behavior_type) title("Spell Survival by Behavior Type")

stcox autoplay timechoice if spell_type==1, cluster(participant_id)  // Work spells
stcox autoplay timechoice if spell_type==0, cluster(participant_id)  // Leisure spells
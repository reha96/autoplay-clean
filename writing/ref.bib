@article{andersenElicitationUsingMultiple2006,
  title = {Elicitation Using Multiple Price List Formats},
  author = {Andersen, Steffen and Harrison, Glenn W. and Lau, Morten Igel and Rutstr{\"o}m, E. Elisabet},
  year = {2006},
  month = dec,
  journal = {Experimental Economics},
  volume = {9},
  number = {4},
  pages = {383--405},
  issn = {1386-4157, 1573-6938},
  doi = {10.1007/s10683-006-7055-6},
  urldate = {2025-08-11},
  abstract = {Abstract             We examine the properties of a popular method for eliciting choices and values from experimental subjects, the multiple price list format. The main advantage of this format is that it is relatively transparent to subjects and provides simple incentives for truthful revelation. The main disadvantages are that it only elicits interval responses, and could be susceptible to framing effects. We consider extensions to address and evaluate these concerns. We conclude that although there are framing effects, they can be controlled for with a design that allows for them. We also find that the elicitation of risk attitudes is sensitive to procedures, subject pools, and the format of the multiple price list table, but that the qualitative findings that participants are generally risk averse is robust. The elicitation of discount rates appear less sensitive to details of the experimental design.},
  copyright = {https://www.cambridge.org/core/terms},
  langid = {english},
  keywords = {s2:autoplay},
  file = {C:\Users\LetzPC Gaming\Zotero\storage\DIAGTMPQ\Andersen et al. - 2006 - Elicitation using multiple price list formats.pdf}
}


@article{jackMultiplePriceLists2022,
  title = {Multiple Price Lists for Willingness to Pay Elicitation},
  author = {Jack, B. Kelsey and McDermott, Kathryn and Sautmann, Anja},
  year = {2022},
  month = nov,
  journal = {Journal of Development Economics},
  volume = {159},
  pages = {102977},
  issn = {0304-3878},
  doi = {10.1016/j.jdeveco.2022.102977},
  urldate = {2025-07-22},
  abstract = {Multiple price lists are a convenient tool to elicit willingness to pay (WTP) in surveys and experiments, but choice patterns such as ``multiple switching'' and ``never switching'' indicate high error rates. Existing measurement approaches often do not provide accurate standard errors and cannot correct for bias due to framing and order effects. We propose to combine a randomization approach with a random-effects latent utility model to detect bias and account for error. Data from a choice experiment in South Africa shows that significant order effects exist which, if uncorrected, would lead to distorted conclusions about subjects' preferences. We provide templates to create a multiple price list survey instrument in SurveyCTO and analyze the resulting data using our proposed methods.},
  keywords = {Multiple price list,Preference elicitation,s2:autoplay,Survey methods,Template module,Willingness to pay},
  file = {C:\Users\LetzPC Gaming\Zotero\storage\WB3FA4BD\content.pdf}
}

